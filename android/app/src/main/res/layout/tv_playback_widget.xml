<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#FF1C1C1E">
    <TextView android:id="@+id/widget_device" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFAAAAAA" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TV Remote" android:textColor="#FFFFFFFF" android:textSize="18sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:textColor="#FFCCCCCC" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    <Button android:id="@+id/widget_play_pause" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Open remote" android:textColor="#FFFFFFFF" />
</LinearLayout>
